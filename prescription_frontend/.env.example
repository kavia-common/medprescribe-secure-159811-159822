# Frontend environment variables

# PUBLIC_INTERFACE
# NEXT_PUBLIC_BACKEND_URL: Base URL for the backend API (FastAPI)
# Example for local dev:
# NEXT_PUBLIC_BACKEND_URL=http://localhost:3001
NEXT_PUBLIC_BACKEND_URL=

# PUBLIC_INTERFACE
# NEXT_PUBLIC_SITE_URL: Public URL of this frontend. Used for auth redirects if needed.
# Example:
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=
